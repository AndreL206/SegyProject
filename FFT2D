def calculate_new_bearing(original_bearing, l, L, stretch_to_square="LxL"):
    """
    Calculate the new bearing of a line after stretching a raster to a square.
    
    Parameters:
        original_bearing (float): The original bearing of the line (in degrees).
        l (float): The shorter dimension of the raster.
        L (float): The longer dimension of the raster.
        stretch_to_square (str): "LxL" or "lxL" to specify the target square.
        
    Returns:
        float: The new bearing (in degrees).
    """
    # Convert bearing to radians
    theta_rad = math.radians(original_bearing)
    
    # Compute stretch factors
    if stretch_to_square == "LxL":
        S_x = L / l
        S_y = 1
    elif stretch_to_square == "lxl":
        S_x = 1
        S_y = l / L
    else:
        raise ValueError("Invalid stretch_to_square value. Use 'LxL' or 'lxL'.")
    
    # Calculate the new slope
    tan_theta_new = math.tan(theta_rad) * S_y / S_x
    
    # Calculate the new bearing in degrees
    new_bearing_rad = math.atan(tan_theta_new)
    new_bearing_deg = math.degrees(new_bearing_rad)
    
    # Ensure the bearing is in the range [0, 360]
    if new_bearing_deg < 0:
        new_bearing_deg += 180
    
    return new_bearing_deg

