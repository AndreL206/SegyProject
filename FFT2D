tocorrect_raster_path = "E:/temp/LPF100_ZB.tif"

# Open the original raster and apply the georeferencing information
with rasterio.open(tocorrect_raster_path) as orig:
    data = orig.read()  # Read the raster data
    profile = orig.profile
    data = data[0]
    data = data[:data.shape[0]//2,
