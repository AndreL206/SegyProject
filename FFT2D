    data_mask[corr_data>=0]=np.nan
    corr_data = corr_data * data_mask

    # Write the updated raster to a new file
    with rasterio.open("E:/temp/BatCor_results/Corrected_DEM.tif", "w", **profile) as dst:
        dst.write(corr_data)

